# ============================================================
# Praxion – Environment Variables (copy to .env and fill in)
# ============================================================

# --- Application ---
APP_NAME=Praxion
APP_ENV=development          # development | staging | production
SECRET_KEY=change-me-in-production
DEBUG=true

# --- Database ---
DATABASE_URL=postgresql+asyncpg://praxion:praxion@localhost:5432/praxion
SYNC_DATABASE_URL=postgresql://praxion:praxion@localhost:5432/praxion

# --- LLM ---
GEMINI_API_KEY=your-gemini-api-key
LLM_PROVIDER=gemini          # gemini | ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- OPA Policy Engine ---
OPA_URL=http://localhost:8181

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=praxion-backend

# --- Frontend ---
FRONTEND_ORIGIN=http://localhost:3000

# --- JWT ---
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
